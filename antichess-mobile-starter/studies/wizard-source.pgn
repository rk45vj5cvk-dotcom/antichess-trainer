[Event "Let's Learn the Wizard Opening - antichess: 5. Nxe2 Qxa2 (6. Qxe8 Qxb2 variation)"]
[Date "2025.11.21"]
[Result "*"]
[Variant "Antichess"]
[ECO "?"]
